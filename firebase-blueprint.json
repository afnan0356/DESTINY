{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account in the simulation engine",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username"]
    },
    "SaveSlot": {
      "title": "SaveSlot",
      "description": "Save slot belonging to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "slotName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "slotName"]
    },
    "Life": {
      "title": "Life",
      "description": "Life simulation thread attached to a save slot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "saveSlotId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "birthYear": { "type": "integer" },
        "currentAge": { "type": "integer" },
        "isDormant": { "type": "boolean" },
        "isAlive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "saveSlotId", "userId", "name", "birthYear"]
    },
    "Character": {
      "title": "Character",
      "description": "Character entity representing core simulation stats",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lifeId": { "type": "string" },
        "userId": { "type": "string" },
        "intelligence": { "type": "integer" },
        "discipline": { "type": "integer" },
        "willpower": { "type": "integer" },
        "ambition": { "type": "integer" },
        "health": { "type": "integer" },
        "looks": { "type": "integer" },
        "smarts": { "type": "integer" },
        "happiness": { "type": "integer" },
        "fertility": { "type": "integer" },
        "energy": { "type": "integer" },
        "athleticPerformance": { "type": "integer" },
        "gender": { "type": "string" },
        "sexuality": { "type": "string" },
        "talent": { "type": "string" },
        "eyeStyle": { "type": "string" },
        "eyeColor": { "type": "string" },
        "skinTone": { "type": "string" },
        "browStyle": { "type": "string" },
        "facialHairStyle": { "type": "string" },
        "facialHairColor": { "type": "string" },
        "hairStyle": { "type": "string" },
        "hairColor": { "type": "string" },
        "geneticHealthModifier": { "type": "number" },
        "geneticIntelligenceModifier": { "type": "number" },
        "geneticLooksModifier": { "type": "number" },
        "birthCity": { "type": "string" },
        "birthCountry": { "type": "string" },
        "bankBalance": { "type": "number" },
        "karma": { "type": "integer" },
        "isDormant": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "lifeId", "userId"]
    },
    "Relationship": {
      "title": "Relationship",
      "description": "Relationship between two characters in the simulation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lifeId": { "type": "string" },
        "userId": { "type": "string" },
        "characterId": { "type": "string" },
        "relatedCharacterId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["Spouse", "Ex", "Parent", "Child", "Sibling", "Friend", "BestFriend", "Enemy"]
        },
        "relationshipStrength": { "type": "integer" },
        "status": {
          "type": "string",
          "enum": ["Active", "Ended", "Deceased"]
        },
        "startedAt": { "type": "integer" },
        "endedAt": { "type": "integer" },
        "sabotageChance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "lifeId", "userId", "characterId", "relatedCharacterId", "type", "relationshipStrength", "status", "startedAt"]
    },
    "FamilyEvent": {
      "title": "FamilyEvent",
      "description": "Chronological family drama and life milestone events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lifeId": { "type": "string" },
        "userId": { "type": "string" },
        "characterId": { "type": "string" },
        "relatedCharacterId": { "type": "string" },
        "eventType": { "type": "string" },
        "gameYear": { "type": "integer" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "lifeId", "userId", "characterId", "eventType", "gameYear", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Player profile documents"
    },
    "/saveSlots/{saveSlotId}": {
      "schema": "SaveSlot",
      "description": "User save slots"
    },
    "/lives/{lifeId}": {
      "schema": "Life",
      "description": "Playthrough life instances"
    },
    "/characters/{characterId}": {
      "schema": "Character",
      "description": "Character simulation state"
    },
    "/relationships/{relationshipId}": {
      "schema": "Relationship",
      "description": "Relationships between characters"
    },
    "/familyEvents/{eventId}": {
      "schema": "FamilyEvent",
      "description": "Family milestone and drama event logs"
    }
  }
}
