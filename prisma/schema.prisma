// Destiny Simulation Engine — Prisma Database Schema
// Master Build Prompt 01 of 20: FOUNDATION

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. User Entity (The Real-World Player Account)
// ---------------------------------------------------------
model User {
  id        String     @id @default(uuid())
  username  String     @unique
  email     String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  saveSlots SaveSlot[]

  @@map("users")
}

// ---------------------------------------------------------
// 2. SaveSlot Entity (Belongs to User, Unlimited per User)
// ---------------------------------------------------------
model SaveSlot {
  id        String   @id @default(uuid())
  userId    String
  slotName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lives     Life[]

  @@index([userId])
  @@map("save_slots")
}

// ---------------------------------------------------------
// 3. Life Entity (Belongs to SaveSlot — Playthrough Thread)
// ---------------------------------------------------------
model Life {
  id         String     @id @default(uuid())
  saveSlotId String
  name       String
  birthYear  Int
  currentAge Int        @default(0)
  isDormant  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  saveSlot   SaveSlot   @relation(fields: [saveSlotId], references: [id], onDelete: Cascade)
  character  Character?

  @@index([saveSlotId])
  @@index([isDormant])
  @@map("lives")
}

// ---------------------------------------------------------
// 4. Character Entity (Belongs to Life — Core Simulation Stats)
// ---------------------------------------------------------
// ARCHITECTURAL MANDATE:
// Karma is stored in this database entity for macro/micro calculations,
// but MUST NEVER be exposed in any API response or client model.
// ---------------------------------------------------------
model Character {
  id           String   @id @default(uuid())
  lifeId       String   @unique
  intelligence Int      @default(50)
  discipline   Int      @default(50)
  willpower    Int      @default(50)
  ambition     Int      @default(50)
  health       Int      @default(80)
  looks        Int      @default(50)
  smarts       Int      @default(50)
  happiness    Int      @default(75)
  karma        Int      @default(50) // HIDDEN FROM CLIENT
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  life         Life     @relation(fields: [lifeId], references: [id], onDelete: Cascade)

  @@index([lifeId])
  @@map("characters")
}
